SUPABASE_URL=Enter your Supabase URL here
SUPABASE_SERVICE_ROLE_KEY= Enter your Supabase Service Role Key here
GOOGLE_CLIENT_ID= enter your Google Client ID here
GOOGLE_CLIENT_SECRET= enter your Google Client Secret here
GOOGLE_REDIRECT_URI= enter your Google Redirect URI here
APP_SECRET= enter your App Secret here
TOKEN_ENCRYPTION_KEY= enter your Token Encryption Key here
FRONTEND_URL=http://localhost:5173

# ==========================================
# LLM GLOBAL SETTINGS
# ==========================================

LLM_MAX_OUTPUT_TOKENS=1000

# Give the router time to move between providers
LLM_MODEL_COOLDOWN_SECONDS=60


# ==========================================
# GROQ
# ==========================================

GROQ_API_KEY=enter your Groq API Key here


# ==========================================
# OPENROUTER
# ==========================================

OPENROUTER_API_KEY= enter your OpenRouter API Key here

# ==========================================
# PLANNER
# ==========================================

PLANNER_MODEL=openrouter/openai/gpt-6-luna-pro
PLANNER_FALLBACK_1=openrouter/openai/gpt-oss-120b
PLANNER_FALLBACK_2=groq/openai/gpt-oss-120b
PLANNER_FALLBACK_3=openrouter/openai/gpt-oss-20b
PLANNER_FALLBACK_4=groq/openai/gpt-oss-20b

PLANNER_MAX_TOKENS=1800


# ==========================================
# FINAL ANSWER
# ==========================================

ANSWER_MODEL=openrouter/openai/gpt-oss-120b
ANSWER_FALLBACK_1=groq/openai/gpt-oss-120b
ANSWER_FALLBACK_2=openrouter/openai/gpt-oss-20b
ANSWER_FALLBACK_3=groq/openai/gpt-oss-20b

FINAL_MAX_TOKENS=1200


# ==========================================
# FAST
